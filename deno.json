{
  "name": "memoryz",
  "version": "1.0.0",
  "exports": "./main.ts",
  "tasks": {
    "dev": "deno run --allow-net --allow-env --allow-read --watch main.ts",
    "start": "deno run --allow-net --allow-env --allow-read main.ts",
    "cli": "deno run --allow-net --allow-env --allow-read cli.ts",
    "migrate": "deno run --allow-net --allow-env --allow-read -e 'import { initDb } from \"./src/db/schema.ts\"; await initDb(); console.log(\"Migration finished\");'"
  },
  "imports": {
    "@libsql/client": "npm:@libsql/client@^0.18.0",
    "@libsql/client/web": "npm:@libsql/client@^0.18.0/web"
  },
  "deploy": {
    "org": "wino",
    "app": "memoryz"
  }
}



